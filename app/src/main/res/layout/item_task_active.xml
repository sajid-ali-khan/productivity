<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <ImageButton
        android:id="@+id/btn_complete_task"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Mark task completed"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_circle_outline"
        app:tint="@color/app_text_secondary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_task_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/app_text_primary"
            android:textSize="15sp"
            tools:text="Complete one module of boot.dev RAG course" />

        <TextView
            android:id="@+id/text_task_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/app_text_muted"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Optional task notes..." />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_star_task"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Star task"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_star_border"
        app:tint="@color/app_text_muted" />

</LinearLayout>
