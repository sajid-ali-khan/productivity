<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/app_surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/app_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_report_habit_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/app_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Read 20 pages" />

            <TextView
                android:id="@+id/text_report_rate_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stat_card"
                android:letterSpacing="0.05"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/app_text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="85% FOLLOWED" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_report_habit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:indicatorColor="@color/app_text_primary"
            app:trackColor="@color/app_stroke"
            app:trackCornerRadius="3dp"
            app:trackThickness="6dp"
            tools:progress="85" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_report_followed_days"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/app_text_secondary"
                android:textSize="13sp"
                tools:text="Followed: 6 days" />

            <TextView
                android:id="@+id/text_report_skipped_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/app_text_muted"
                android:textSize="13sp"
                tools:text="Skipped: 1 day" />

            <TextView
                android:id="@+id/text_report_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/app_text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Streak: 4d" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
