<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <ImageButton
        android:id="@+id/btn_uncomplete_task"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Mark task uncompleted"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_check"
        app:tint="@color/app_text_muted" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_completed_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/app_text_muted"
            android:textSize="15sp"
            tools:text="Morning Stretch" />

        <TextView
            android:id="@+id/text_completed_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/app_text_muted"
            android:textSize="12sp"
            tools:text="Completed: Mon, Sep 7" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_delete_task"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Delete task"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_delete"
        app:tint="@color/app_text_muted" />

</LinearLayout>
