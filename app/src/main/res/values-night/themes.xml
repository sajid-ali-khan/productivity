<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Productivity" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Primary Colors -->
        <item name="colorPrimary">@color/app_btn_primary</item>
        <item name="colorOnPrimary">@color/app_btn_primary_text</item>
        <item name="colorPrimaryContainer">@color/app_surface_variant</item>
        <item name="colorOnPrimaryContainer">@color/app_text_primary</item>

        <!-- Secondary & Tertiary Shades -->
        <item name="colorSecondary">@color/app_text_secondary</item>
        <item name="colorOnSecondary">@color/app_surface</item>
        <item name="colorSecondaryContainer">@color/app_surface_variant</item>
        <item name="colorOnSecondaryContainer">@color/app_text_primary</item>

        <!-- Surfaces & Backgrounds -->
        <item name="android:colorBackground">@color/app_bg</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_text_primary</item>
        <item name="colorSurfaceVariant">@color/app_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/app_text_secondary</item>

        <!-- Outline & Borders -->
        <item name="colorOutline">@color/app_stroke</item>
        <item name="colorOutlineVariant">@color/app_stroke_light</item>

        <!-- Status & Navigation bars -->
        <item name="android:statusBarColor">@color/app_bg</item>
        <item name="android:navigationBarColor">@color/app_nav_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <!-- Default font family -->
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
    </style>
</resources>
